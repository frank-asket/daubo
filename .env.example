# =============================================================================
# Environment reference — Daubo
# Copy values into Vercel / Railway dashboards. Never commit real secrets.
# =============================================================================
#
# ┌─────────────────┬──────────────────────────────────────────────────────────┐
# │ Variable        │ Where it belongs                                          │
# ├─────────────────┼──────────────────────────────────────────────────────────┤
# │ Clerk (public)  │ Vercel only (NEXT_PUBLIC_*)                             │
# │ Clerk (secret)  │ Vercel only (CLERK_SECRET_KEY)                           │
# │ DAUBO_API_URL   │ Vercel only — HTTPS base URL of Railway API              │
# │ DAUBO_INTERNAL  │ Vercel AND Railway — MUST match exactly                │
# │ DATABASE_URL    │ Railway only (FastAPI service)                         │
# │ BACKEND_CORS_*  │ Railway only — include your Vercel origin(s)            │
# │ OPENROUTER_*    │ Railway only (if you use chat)                         │
# │ ADZUNA_*        │ Railway only (optional — live job rows in discover)     │
# │ JINA_*          │ Railway only (if you use embeddings)                   │
# └─────────────────┴──────────────────────────────────────────────────────────┘

# =============================================================================
# CUSTOMER-FACING (Vercel — optional, no secrets)
# =============================================================================
# Shown in footer, support page, and onboarding card when set.
# NEXT_PUBLIC_PRODUCT_NAME=Daubo
# NEXT_PUBLIC_SUPPORT_EMAIL=hello@yourdomain.com
# NEXT_PUBLIC_TERMS_URL=https://yourdomain.com/terms
# NEXT_PUBLIC_PRIVACY_URL=https://yourdomain.com/privacy
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/yourteam/intro

# =============================================================================
# VERCEL — Next.js (Project → Settings → Environment Variables)
# =============================================================================
# Production: use Clerk pk_live_ / sk_live_ keys from your production instance.

# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
# NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# Public HTTPS base URL of your Railway API (no trailing slash, do not append /v1).
# DAUBO_API_URL=https://your-api.up.railway.app

# Same secret as on Railway FastAPI service (BFF sends X-Daubo-Internal-Key).
# DAUBO_INTERNAL_API_SECRET=

# Google OAuth (Gmail drafts — gmail.compose). Web client ID on Vercel; full triplet on Railway.
# Redirect URI must match exactly, e.g. https://YOUR_VERCEL_HOST/api/gmail/oauth/callback
# GOOGLE_OAUTH_CLIENT_ID=
# (Vercel only needs CLIENT_ID + same DAUBO_INTERNAL_API_SECRET for signed OAuth state.)

# =============================================================================
# RAILWAY — FastAPI service (Variables tab on the API deployment)
# Postgres plugin exposes DATABASE_URL; reference it or paste Neon/Supabase URL.
# =============================================================================

# DATABASE_URL=${{Postgres.DATABASE_URL}}
# (postgres:// or postgresql:// is OK — the app normalizes to postgresql+asyncpg)

# APP_ENVIRONMENT=production
# LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API (your Vercel URL(s)).
# BACKEND_CORS_ORIGINS=https://your-app.vercel.app

# DAUBO_INTERNAL_API_SECRET=
# EXPOSE_OPENAPI=false
# TRUSTED_HOSTS=
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback
#
# OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# Must match a live id on https://openrouter.ai/models — anthropic/claude-3.5-sonnet returns 404 (no route).
# Daubo auto-falls back to openai/gpt-4o-mini if anthropic/claude-3.5-sonnet is set; for Claude, copy an exact Anthropic slug from the model list.
# OPENROUTER_HTTP_REFERER=https://your-app.vercel.app
# OPENROUTER_APP_TITLE=Daubo

# JINA_API_KEY=
# JINA_EMBEDDING_MODEL=jina-embeddings-v3
# JINA_EMBEDDING_DIMENSION=1024

# Docker / Railway image already binds 0.0.0.0:8000 — usually omit locally only:
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000

# =============================================================================
# LOCAL DEVELOPMENT
#
# There is usually NO `backend/.env` file in the repo: `.env` is gitignored, and you
# are not required to create `backend/.env`. The FastAPI app loads env from, in order:
#   1) `backend/.env` if you create it
#   2) `../.env` (repo root) — typical setup: one root `.env` with everything below.
#
# Next.js loads `.env`, `.env.local`, etc. from the repo root only.
# =============================================================================

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dm9jYWwtam9leS0xNC5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_z122C6yBj0Z6YO8G99hq7iRYkQJ5LlcaxwUz99VhqQ
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

DAUBO_API_URL=http://localhost:8000
DAUBO_INTERNAL_API_SECRET=

DATABASE_URL=postgresql+asyncpg://daubo:daubo@localhost:5432/daubo

APP_ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
EXPOSE_OPENAPI=true

# Optional: max saved jobs per user (POST /v1/me/applications). 0 = unlimited.
# DAUBO_MAX_JOB_APPLICATIONS_PER_USER=50

OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# Vision model on OpenRouter for resume images (PNG/JPEG/WebP). Required for image uploads.
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Daubo

# Optional: https://developer.adzuna.com/ — adds real postings to discover + resume auto-match.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Lowercase region slug when inferred country is unmapped (us, gb, fr, …). Use empty to disable fallback.
# ADZUNA_DEFAULT_COUNTRY=us

JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSION=1024

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
