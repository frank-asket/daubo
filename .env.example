# Copy to `.env.local` (Next.js) and/or `.env` / `backend/.env`.
# Never commit real secrets.

# ─── Clerk (auth + Billing) ────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dm9jYWwtam9leS0xNC5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_z122C6yBj0Z6YO8G99hq7iRYkQJ5LlcaxwUz99VhqQ
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Next.js → FastAPI (Vercel + production backend) ─────────────────────────
# Public URL of your deployed API, e.g. https://api.yourdomain.com
DAUBO_API_URL=http://localhost:8000
# Same random secret on Vercel and on the API (enables X-Daubo-Internal-Key checks)
DAUBO_INTERNAL_API_SECRET=

# ─── Database (PostgreSQL + pgvector) ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://daubo:daubo@localhost:5432/daubo

# ─── FastAPI production tuning ─────────────────────────────────────────────
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated origins, e.g. https://your-app.vercel.app,http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000
# Optional: host names allowed when behind a reverse proxy (e.g. api.yourdomain.com)
TRUSTED_HOSTS=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Set false in production to hide /docs and /openapi.json
EXPOSE_OPENAPI=true

# ─── OpenRouter ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Daubo

# ─── Jina AI (embeddings) ───────────────────────────────────────────────────
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSION=1024

# ─── Process bind (Docker / local uvicorn) ──────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
